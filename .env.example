# ==============================================================================
# Achados e Perdidos CIn-UFPE — Variáveis de Ambiente de Exemplo
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente local.
# NUNCA comite credenciais ou o arquivo .env real no repositório (Invariante 9).
# Todos os valores abaixo são fictícios para desenvolvimento e testes.
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# Único ponto de integração entre worker e site (ARQUITETURA.md §1.2, ADR-001).
# ------------------------------------------------------------------------------
# Usados pelo `docker compose up` (SCRUM-70). Valores de desenvolvimento local, sem segredo real.
POSTGRES_USER=longuinho
POSTGRES_PASSWORD=longuinho
POSTGRES_DB=longuinho
POSTGRES_PORT=5432

# URL que worker e API usam. Em produção, troque usuário, senha e host.
DATABASE_URL=postgresql://longuinho:longuinho@localhost:5432/longuinho

# ------------------------------------------------------------------------------
# Autenticação Google OAuth 2.0 (Site / API)
# Login restrito exclusivamente a contas @cin.ufpe.br (ARQUITETURA.md §2.1, ADR-010, ADR-011).
# ------------------------------------------------------------------------------
# nome proposto
ALLOWED_EMAIL_DOMAIN=cin.ufpe.br

# nome proposto
GOOGLE_CLIENT_ID=troque-por-client-id

# nome proposto
GOOGLE_CLIENT_SECRET=troque-por-client-secret

# Porta 8000 é a da API em desenvolvimento. O caminho inclui o prefixo /api (decisão do PO em 13/11/2026).
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ------------------------------------------------------------------------------
# Worker de Ingestão (Python)
# Abstração de leitura e envio para permitir execução offline (ARQUITETURA.md §2.3, ADR-003).
# ------------------------------------------------------------------------------
# nome proposto: fonte ativa de leitura (opções: arquivos_locais, gmail, formulario)
WORKER_FONTE_MENSAGENS=arquivos_locais

# nome proposto: modo ativo de envio (opções: nao_enviar, arquivo, gmail)
WORKER_MODO_ENVIO=nao_enviar

# nome proposto: diretório do corpus para testes locais sem rede
WORKER_ARQUIVOS_LOCAIS_DIR=worker/corpus/casos

# Intervalo entre ciclos quando o worker roda sem --uma-vez (só desenvolvimento; produção usa cron)
WORKER_INTERVALO_SEGUNDOS=300

# Banco de teste do worker (testes e `python -m worker.avaliar`). É apagado e recriado a cada execução.
# Vazio = DATABASE_URL com o sufixo _teste_worker no nome do banco.
DATABASE_URL_TESTE=

# Extração (US-03). gliner (padrão) ou simulado (sem modelo: só as regras fechadas; usado nos testes)
WORKER_EXTRATOR=gliner
WORKER_GLINER_MODELO=urchade/gliner_multi-v2.1
WORKER_GLINER_LIMIAR=0.4
# Onde o modelo fica em cache. Vazio = ~/.cache/huggingface. No Docker é /modelos (volume).
HF_HOME=

# US-15: aviso ao autor só para anúncios a partir desta data (AAAA-MM-DD). Vazia = nenhum aviso sai.
# A primeira leitura do Gmail traz o histórico inteiro; ponha a data em que o worker começou a ler a lista.
# O envio usa EMAIL_MODO_ENVIO e SMTP_* (seção de envio abaixo); WORKER_MODO_ENVIO não é lida pelo worker.
WORKER_AVISO_A_PARTIR_DE=

# nome proposto: conta do projeto para leitura por encaminhamento (quando em modo gmail)
GMAIL_PROJECT_ACCOUNT=troque-por-conta-do-projeto@exemplo.invalid

# nome proposto: caminho para o arquivo de credenciais da API do Gmail (quando em modo gmail)
GMAIL_PROJECT_CREDENTIALS_FILE=/caminho/ficticio/para/troque-por-credenciais.json

# Token OAuth gravado por `python -m worker.autorizar_gmail` (só leitura). Fora do Git.
GMAIL_TOKEN_FILE=worker/.segredos/token.json
# Pasta montada em /segredos no contêiner do worker (token.json e credenciais.json).
GMAIL_SEGREDOS_DIR=./worker/.segredos

# ------------------------------------------------------------------------------
# API REST (Site / API)
# ------------------------------------------------------------------------------
# Prefixo de todas as rotas, igual ao `servers` do shared/openapi.yaml (decisão do PO em 13/11/2026)
API_PREFIX=/api

# Nome do cookie de sessão HTTP-only, igual ao `cookieAuth` do contrato
SESSION_COOKIE_NAME=sessao_id

# Segredo que assina o cookie de sessão. Gere um longo e aleatório em produção.
SESSAO_SEGREDO=troque-por-um-segredo-longo-e-aleatorio

# Login simulado para desenvolver sem credencial do Google: um e-mail fictício @cin.ufpe.br.
# Vazio = desligado. NUNCA preencha em produção.
LOGIN_SIMULADO=

# Endereços públicos do site e da API (links nos e-mails, redirecionamentos do login)
SITE_URL=http://localhost:5173
API_URL=http://localhost:8000

# Pasta onde a API guarda as fotos enviadas (US-06). Servidas em /api/fotos/
FOTOS_DIR=./dados/fotos

# Segundos que a API espera por uma conexão do banco antes de responder 503 INDISPONIVEL
BANCO_TIMEOUT=5

# Banco dos testes da API (pytest). Vazio = DATABASE_URL com o nome trocado para longuinho_teste_api.
# O banco de teste é APAGADO e recriado a cada execução: o nome precisa conter "teste".
DATABASE_URL_TESTE=

# ------------------------------------------------------------------------------
# Envio de e-mail pela conta do projeto (aviso ao autor US-15, contato US-05)
# Modos: nao_enviar (padrão em desenvolvimento), arquivo (grava .eml em EMAIL_ARQUIVO_DIR), smtp
# Em desenvolvimento e em teste, NUNCA smtp. Com smtp, a API não sobe sem EMAIL_REMETENTE e SMTP_* reais
# (SMTP_SENHA é a senha de app do Gmail do projeto, com STARTTLS na porta 587).
# ------------------------------------------------------------------------------
EMAIL_MODO_ENVIO=nao_enviar
EMAIL_ARQUIVO_DIR=./dados/emails-enviados
EMAIL_REMETENTE=troque-por-conta-do-projeto@exemplo.invalid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=troque-por-conta-do-projeto@exemplo.invalid
SMTP_SENHA=troque-por-senha-de-app


# ------------------------------------------------------------------------------
# Site (React + Vite)
# Só as variáveis que começam com VITE_ chegam ao navegador. NUNCA ponha segredo nelas.
# ------------------------------------------------------------------------------
# Canal humano de remoção do rodapé (US-09, ADR-011): o endereço +remocao da conta do projeto.
VITE_EMAIL_REMOCAO=troque-por-conta-do-projeto+remocao@exemplo.invalid
