# ==============================================================================
# Achados e Perdidos CIn-UFPE — Variáveis de Ambiente de Exemplo
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente local.
# NUNCA comite credenciais ou o arquivo .env real no repositório (Invariante 9).
# Todos os valores abaixo são fictícios para desenvolvimento e testes.
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# Único ponto de integração entre worker e site (ARQUITETURA.md §1.2, ADR-001).
# ------------------------------------------------------------------------------
# nome proposto
DATABASE_URL=postgresql://troque-por-usuario:troque-por-senha@localhost:5432/troque-por-banco

# ------------------------------------------------------------------------------
# Autenticação Google OAuth 2.0 (Site / API)
# Login restrito exclusivamente a contas @cin.ufpe.br (ARQUITETURA.md §2.1, ADR-010, ADR-011).
# ------------------------------------------------------------------------------
# nome proposto
ALLOWED_EMAIL_DOMAIN=cin.ufpe.br

# nome proposto
GOOGLE_CLIENT_ID=troque-por-client-id

# nome proposto
GOOGLE_CLIENT_SECRET=troque-por-client-secret

# nome proposto (porta provisória, a definir com o back-end)
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ------------------------------------------------------------------------------
# Worker de Ingestão (Python)
# Abstração de leitura e envio para permitir execução offline (ARQUITETURA.md §2.3, ADR-003).
# ------------------------------------------------------------------------------
# nome proposto: fonte ativa de leitura (opções: arquivos_locais, gmail, formulario)
WORKER_FONTE_MENSAGENS=arquivos_locais

# nome proposto: modo ativo de envio (opções: nao_enviar, arquivo, gmail)
WORKER_MODO_ENVIO=nao_enviar

# nome proposto: diretório do corpus para testes locais sem rede
WORKER_ARQUIVOS_LOCAIS_DIR=worker/corpus/casos

# nome proposto: conta do projeto para leitura por encaminhamento (quando em modo gmail)
GMAIL_PROJECT_ACCOUNT=troque-por-conta-do-projeto@exemplo.invalid

# nome proposto: caminho para o arquivo de credenciais da API do Gmail (quando em modo gmail)
GMAIL_PROJECT_CREDENTIALS_FILE=/caminho/ficticio/para/troque-por-credenciais.json

# ------------------------------------------------------------------------------
# Configurações em Aberto (Placeholders)
# ------------------------------------------------------------------------------
# Nome do cookie de sessão HTTP-only (a definir com a equipe / contrato)
# SESSION_COOKIE_NAME=

# Prefixo de rotas da API REST (a definir com a equipe / contrato)
# API_PREFIX=

